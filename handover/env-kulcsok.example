# ============================================================================
# Kineticare – a kézikönyvben külön magyarázott env-kulcsnevek (2026-09-23)
# ----------------------------------------------------------------------------
# TITOK SOHA nem kerül a repóba. Ez a fájl CSAK kulcsneveket ír, érték nélkül.
# A kanonikus, teljes lista: a gyökér `.env.example`.
# Másold a gyökér `.env.example`-t `.env`-vé; ide értéket ne írj.
# ============================================================================

# Seed NEM dry-run. Üres + nem-éles URL = teljes seed ír.
# `kezdolap` = szűkített írás (kezdőlap + landing képek), éles URL-en is.
SEED_SCOPE=
# Éles URL-en a teljes seed el sem indul. `igen` = tudatos teljes seed.
SEED_CONFIRM_LIVE=
# Első user: érvényes token + header nélkül a fiók NEM jön létre (503/403).
# Min. 32 karakter. Header: x-kineticare-bootstrap-token.
FIRST_USER_BOOTSTRAP_TOKEN=
# `true` = a middleware nem rak noindex-et. NEXT_PUBLIC_, újrabuild kell.
NEXT_PUBLIC_ALLOW_INDEXING=
# `true` = a cf-connecting-ip megbízható (Cloudflare mögött).
TRUST_CF_CONNECTING_IP=
# x-forwarded-for hop jobbról. Üres = 1.
TRUSTED_PROXY_HOP_COUNT=
# Owner-script íráskapuk. Érték pontosan `igen`, különben próbafutás.
OWNER_BACKFILL_CONFIRM=
OWNER_TUDASTAR_CONFIRM=
OWNER_TUDASTAR_PUBLISH=
OWNER_HUB_PUBLISH=
OWNER_CONTENT_CONFIRM=
OWNER_BUNNY_CURRICULUM_CONFIRM=
MIGRATION_NOTICE_CONFIRM=
# railway.email-job.json script-argumentum. Futás után ürítsd.
EMAIL_JOB_ARGS=
# railway.import-job.json (scripts/import-job.sh) bemenete. Futás után ürítsd.
# A gyökér .env.example még nem jelöli (maintainer-teendő).
IMPORT_CUSTOMERS_CSV_GZ_B64=
# Levélküldő (RESEND_API_KEY vagy SMTP_HOST) mellett kötelező, különben boot-hiba.
EMAIL_FROM=
# `true` = a cron workerek futnak. Az éles címen hiánya boot-hiba, kivéve ha
# a JOB_WORKERS_OFF_CONFIRM nyugtázza; más éles futásban csak warn.
ENABLE_JOB_WORKERS=
# `igen` = a workerek tudatos kikapcsolása az éles címen (RIASZTÁS mellett
# indul). A gyökér .env.example még nem jelöli (maintainer-teendő).
JOB_WORKERS_OFF_CONFIRM=
# `false` = a Barion Start négy 3DS-blokkja kimarad (vészkapcsoló); üresen
# bekapcsolva. A gyökér .env.example még nem jelöli (maintainer-teendő).
BARION_SEND_3DS=
# `1` = seed:demo futhat. Éles Kineticare-en TILOS.
DEMO_MODE=
DEMO_COURSE_SKU=
DEMO_CUSTOMER_PASSWORD=
# Legacy restore / menü-seed / consent E2E.
LEGACY_RESTORE_CONFIRM=
LEGACY_OVERWRITE=
MENU_SEED_DRY_RUN=
E2E_EXPECT_ANALYTICS=
