{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install": {
      "inputs": [
        "...",
        {
          "local": true,
          "include": [
            ".npmrc",
            "package.json",
            "package-lock.json",
            "scripts/exact-npm-cli.mjs",
            "scripts/install-reviewed-dependencies.mjs",
            "scripts/verify-install-script-lock.mjs",
            "scripts/verify-install-script-lock.sha256"
          ]
        }
      ],
      "commands": [
        "node scripts/install-reviewed-dependencies.mjs",
        {
          "path": "node_modules/.bin"
        }
      ]
    },
    "build": {
      "commands": ["node ./node_modules/next/dist/bin/next build"]
    }
  },
  "deploy": {
    "startCommand": "node ./node_modules/payload/bin.js migrate && exec node ./node_modules/next/dist/bin/next start"
  }
}
