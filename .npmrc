# A legacy-peer-deps flag indoka: a @payloadcms/* 3.88.0 peer-tartomanya a
# next@16.3.3-at engedi (`>=16.2.6 <17.0.0` — @payloadcms/next es @payloadcms/ui),
# tehat nem peer-utkozes miatt kell. A package-lock.json legacy-peer-deps
# modban keszult es igy lett validalva; a flag minden npm-folyamatra ervenyes
# (Railway Railpack, lokalis fejlesztes, CI). Eltavolitasa csak kulon,
# szigoru peer-feloldassal validalt lockfile-frissitesben biztonsagos.
legacy-peer-deps=true
