# ============================================================================
# Kineticare – környezeti változók mintája
# ----------------------------------------------------------------------------
# TITOK SOHA nem kerül a repóba! Ez a fájl csak a kulcsokat írja le, érték nélkül.
# Másold le:  cp .env.example .env   – és a .env-ben add meg a valódi értékeket
# (a .env gitignore-olt). Staging/prod környezetben a Railway változói a forrás.
# A staging SOHA nem mutathat éles Barion/Számlázz.hu fiókra!
# Kötelező-jelölés: [mindenhol] = local+staging+prod, [prod] = csak éles, stb.
# ============================================================================

# ----------------------------------------------------------------------------
# Alkalmazás (app)
# ----------------------------------------------------------------------------
# Az app nyilvános alap-URL-je (Payload/Next canonical URL, e-mail linkjei). [mindenhol]
NEXT_PUBLIC_SERVER_URL=
# Payload CMS titkosítási kulcsa (session/token aláírás) – hosszú, véletlen string. [mindenhol]
PAYLOAD_SECRET=
# A feltöltött képek célkönyvtára (Payload upload staticDir) – ABSZOLÚT útvonal.
# ÉLESBEN KÖTELEZŐ, és a Railway-hez csatolt Volume mountpontjára kell mutatnia
# (/app/media): a konténer lemeze minden deploynál üresen jön vissza, kötet nélkül
# tehát az összes feltöltött kép elveszik (a DB-rekord marad, a fájl eltűnik,
# a /api/media/file/... HTTP 500-at ad). Üres = a Payload alapértelmezése
# (<munkakönyvtár>/media) – lokális fejlesztéshez ez a jó. [prod kötelező, local opcionális]
PAYLOAD_MEDIA_DIR=

# ----------------------------------------------------------------------------
# Adatbázis (PostgreSQL)
# ----------------------------------------------------------------------------
# PostgreSQL kapcsolati string (postgresql://user:pass@host:5432/db). [mindenhol]
DATABASE_URI=

# ----------------------------------------------------------------------------
# Barion (fizetés)
# ----------------------------------------------------------------------------
# Barion POSKey a TESZT környezethez – local/staging kötelezően EZT használja. [local+staging]
BARION_POSKEY_TEST=
# Barion POSKey az ÉLES környezethez – csak prod, stagingen SOHA ne legyen beállítva. [prod]
BARION_POSKEY_PROD=
# Barion Payee e-mail (a kereskedői fiók azonosítója). [mindenhol]
BARION_PAYEE_EMAIL=
# Barion API alap-URL – test: api.test.barion.com, prod: api.barion.com (környezetenként más!). [mindenhol]
BARION_API_URL=

# ----------------------------------------------------------------------------
# Számlázz.hu (Számla Agent – számlázás, T-024/W4-01)
# ----------------------------------------------------------------------------
# Számla Agent API-kulcs – stagingen csak teszt/pékszámla-fiók kulcsa szerepelhet.
# Üres = a számlázás KIKAPCSOLVA (nem hiba): a fizetési lánc működik, a számla nem készül. [opcionális]
SZAMLAZZ_AGENT_KEY=
# Számla-előtag (a Számlázz.hu felületen beállított Előtagok egyike, pl. KIN). Üres = KIN. [opcionális]
SZAMLAZZ_INVOICE_PREFIX=
# Tétel-áfakulcs: '27' (általános) vagy 'AAM' (alanyi adómentes eladó).
# BEKAPCSOLT számlázásnál (van SZAMLAZZ_AGENT_KEY) KÖTELEZŐ, alapértelmezés NINCS:
# a rossz kulcs minden számlát elront, és utólag csak helyesbítővel javítható.
# A cég adószámának 9. jegye dönti el (1 = alanyi adómentes → AAM, 2 = áfás → 27);
# kulcs nélküli, kikapcsolt számlázásnál az érték közömbös. [élesben kötelező]
SZAMLAZZ_AFAKULCS=
# Számla Agent végpont. Üres = https://www.szamlazz.hu/szamla (az alapértelmezett). [opcionális]
SZAMLAZZ_API_URL=
# Számlázz.hu hívástimeout ezredmásodpercben. Üres = 15000 (15 mp). [opcionális]
SZAMLAZZ_TIMEOUT_MS=

# ----------------------------------------------------------------------------
# Bunny Stream (videó-hosting) – mind OPCIONÁLIS, a hiányuk nem dönti el az appot
# (a videó ilyenkor a magyar „nem érhető el" úton degradálódik).
# Részletek: docs/video-platform-dontes.md 4.6.
# ----------------------------------------------------------------------------
# A VÉDETT library token-hitelesítési kulcsa – ezzel készül a lejátszási jegy
# SHA256-hash-e. TITOK: szerveroldali, sosem kerül a böngészőbe, sosem e-mailben
# vagy chaten megy. Üres = a token-végpont 503-at ad magyar üzenettel, az app
# ettől még fut. [videó élesítésekor kötelező]
BUNNY_STREAM_TOKEN_AUTH_KEY=
# A VÉDETT library Stream API kulcsa (videólista az adminban). TITOK: ez NEM a
# lejátszási token-kulcs, hanem a Bunny Stream → a library → API oldalon lévő
# AccessKey. Üres = a Videótár „nincs bekötve” üzenetet mutat, az app fut.
# [videólista élesítésekor kötelező]
BUNNY_STREAM_LIBRARY_API_KEY=
# A PUBLIKUS library Stream API kulcsa (előzetesek listája). TITOK, library-
# szintű, külön a védett kulcstól. Üres = a nyilvános tár listája nem tölthető.
# [publikus videólista élesítésekor kötelező]
BUNNY_STREAM_PUBLIC_LIBRARY_API_KEY=
# A VÉDETT videó-library numerikus azonosítója (kurzus-epizódok). NEM titok
# (minden embed-URL-ben látszik), de NEXT_PUBLIC_, ezért BUILD IDEJÉN kell jelen
# lennie – utólagos beállítás után ÚJRA KELL BUILDELNI. Üres = a kurzuslejátszó
# a magyar „nem érhető el" üzenetet mutatja. [videó élesítésekor kötelező]
NEXT_PUBLIC_BUNNY_STREAM_LIBRARY_ID=
# A PUBLIKUS videó-library azonosítója (hero-videó, kurzus-előzetesek – token
# nélkül). A Bunnynál a token-hitelesítés LIBRARY-szintű, ezért a publikus és a
# védett tartalom külön libraryben él. Üres = az előzetes-szekció rejtve marad.
# [publikus videó élesítésekor kötelező]
NEXT_PUBLIC_BUNNY_STREAM_PUBLIC_LIBRARY_ID=
# A videó-library pull-zone hosztneve (alak: vz-<azonosito>.b-cdn.net) – ebből
# jönnek a poszterképek, és ez kerül a CSP img-src/media-src forrásába PONTOS
# hosztként. Üres vagy formailag gyanús érték = a CSP a szabályos
# https://*.b-cdn.net jokerre esik vissza (src/lib/security/csp.ts).
# [videó élesítésekor kötelező]
NEXT_PUBLIC_BUNNY_STREAM_PULL_ZONE_HOST=

# ----------------------------------------------------------------------------
# E-mail (Resend – megrendelői döntés; az SMTP a tartalék út)
# ----------------------------------------------------------------------------
# A kiválasztott szolgáltató a RESEND. A provider-választás env-alapú
# (src/lib/email/provider.ts): RESEND_API_KEY → Resend, egyébként SMTP_HOST →
# SMTP, ha egyik sincs → noop (a levelek nem mennek ki, de semmi nem crashel;
# a rendszer egyszer figyelmeztet a naplóban). A vásárló-migráció levélküldő
# módja (--send-invites) noop mellett szándékosan EL SEM INDUL.
# SMTP szerver host (tranzakciós e-mailek: regisztráció, visszaigazolás). [SMTP esetén mindenhol]
SMTP_HOST=
# SMTP port (jellemzően 587 STARTTLS / 465 SSL). [SMTP esetén mindenhol]
SMTP_PORT=
# SMTP felhasználónév. [SMTP esetén mindenhol]
SMTP_USER=
# SMTP jelszó. [SMTP esetén mindenhol]
SMTP_PASS=
# Resend API-kulcs. TITOK: kizárólag a Railway → Variables felületén, a repóba
# (és .env-be sem, ha megosztott gépen dolgozol) SOHA. [Resend esetén mindenhol]
RESEND_API_KEY=
# Feladó e-mail-cím és név ("Név <cim@domain>" vagy puszta cím formában).
# A domainnek a Resendben HITELESÍTETTNEK kell lennie (SPF + DKIM DNS-rekordok),
# különben a Resend elutasítja a küldést. Üres = noreply@localhost, ami élesben
# biztosan visszapattan. [mindenhol]
EMAIL_FROM=

# ----------------------------------------------------------------------------
# PostHog (termék-analitika) – mind OPCIONÁLIS
# ----------------------------------------------------------------------------
# PostHog project API key (a PostHog EU-projectből). Üres = az analitika
# KIKAPCSOLVA (no-op, nem hiba). Nyilvános (NEXT_PUBLIC) projekt-kulcs,
# NEM személyes API-kulcs! A bekapcsoláshoz a látogatói analytics-hozzájárulás
# is kell (consent-banner), lásd docs/posthog.md. [opcionális]
NEXT_PUBLIC_POSTHOG_KEY=
# PostHog host. Üres = https://eu.i.posthog.com (EU-cloud, GDPR-barát).
# Self-hosted esetén a saját példány URL-je. [opcionális]
NEXT_PUBLIC_POSTHOG_HOST=

# ----------------------------------------------------------------------------
# Google Analytics 4 – OPCIONÁLIS
# ----------------------------------------------------------------------------
# GA4 mérési azonosító (G-…). Üres = a GA teljesen kikapcsolt (no-op).
# NEXT_PUBLIC_, tehát build-időben ég bele — beállítás után újrabuild kell
# (a CSP-fejléc is ekkor dől el). A gtag.js csak analytics-consent után
# töltődik be. Részletek: docs/ga4.md. [opcionális]
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console domain-ellenőrző meta (nyilvános, nem titok).
# A DNS átállás után a válasznál kell, ha a régi Systeme.io-s
# ellenőrzés nem viszi át a tulajdont. Érték nélkül nincs meta.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Extra CORS/CSRF eredetek (vesszővel). A DNS-cutover előtt, amíg a
# NEXT_PUBLIC_SERVER_URL még a Railway-URL, ide kell:
# https://kineticare.hu,https://www.kineticare.hu
EXTRA_ALLOWED_ORIGINS=

# Google Ads konverzió-azonosító (AW-…). ÜRES. Ne állítsd be, amíg
# a docs/ga4.md ad_storage tiltása él — a kód NEM nyit reklám-sütit.
NEXT_PUBLIC_GOOGLE_ADS_ID=

# ----------------------------------------------------------------------------
# Barion Pixel – a Smart Gateway FELTÉTELE (nem marketing-extra)
# ----------------------------------------------------------------------------
# Barion Pixel azonosító a Barion admin „Shops / Pixel” oldaláról.
# Alakja: BP- + 10 jel + - + 2 jel, összesen 16 karakter (pl. BP-oA1zcu4uwm-C0).
# A BPT-vel kezdődő azonosító NEM Pixel-azonosító, azzal nem működik!
# A teszt (sandbox) és az éles fiók azonosítója KÜLÖNBÖZIK – a stagingre az
# éles azonosítót beírni tilos, mert összekeverednék az éles mérés.
#
# Üres = a Pixel teljesen kimarad (se script, se noscript-kép, se CSP-forrás) –
# ez nem hiba, fejlesztésben ez a normális. ÉLESBEN viszont a Barion Smart
# Gateway használatának feltétele, hogy az alap Pixel jelen legyen: a Barion
# csalásmegelőző pontozása ebből dolgozik. Az alap Pixel ezért a süti-
# hozzájárulástól FÜGGETLENÜL betöltődik (jogalap: jogos érdek); a hozzájárulás
# a Pixel felhasználását szabályozza, nem a betöltését.
#
# NEXT_PUBLIC_, tehát BUILD IDEJÉN ég bele a kliens-csomagba – beállítás után
# ÚJRABUILD kell (a CSP-fejléc `pixel.barion.com` forrásai is ekkor dőlnek el,
# vö. a Next.js build-időben sütött headers()-e). [opcionális, élesben ajánlott]
NEXT_PUBLIC_BARION_PIXEL_ID=

# ----------------------------------------------------------------------------
# Feature flagek
# ----------------------------------------------------------------------------
# Háttérfolyamatok (job workerek: webhook-retry, order-poll, invoice-issue)
# bekapcsolása – "true"/"false", local jellemzően false. [mindenhol]
ENABLE_JOB_WORKERS=

# ----------------------------------------------------------------------------
# Naplózás
# ----------------------------------------------------------------------------
# Log-szint: debug | info | warn | error (prod javasolt: info vagy warn). [mindenhol]
LOG_LEVEL=

# ----------------------------------------------------------------------------
# Kapcsolat űrlap + spam-védelem (T-016) – mind OPCIONÁLIS
# ----------------------------------------------------------------------------
# Staff-értesítő címzettlista kapcsolat-űrlap beküldéskor (vesszővel elválasztott
# e-mail-címek). Üres = nincs staff-értesítő, a beküldés ettől mentődik. [opcionális]
CONTACT_STAFF_EMAILS=
# Cloudflare Turnstile site key (kliensoldali widget). Üres = spam-védelem ki. [opcionális]
TURNSTILE_SITE_KEY=
# Cloudflare Turnstile secret key (szerveroldali siteverify-ellenőrzés). Üres = ki. [opcionális]
TURNSTILE_SECRET_KEY=

# ----------------------------------------------------------------------------
# Barion-kliens kapcsolók (src/lib/barion) – a fenti Barion-szekció kiegészítése
# ----------------------------------------------------------------------------
# Aktív Barion-környezet: test | prod. Üres = test. Ez választja ki, hogy a
# BARION_POSKEY_TEST vagy a BARION_POSKEY_PROD a kötelező kulcs. [mindenhol]
BARION_ENVIRONMENT=
# Barion API hívástimeout ezredmásodpercben. Üres = 15000 (15 mp). [opcionális]
BARION_TIMEOUT_MS=
# Recurring (ismétlődő) fizetés előkészítésének feature-flage: "true" = be.
# Üres/más = ki (alapértelmezés), ilyenkor recurring-paraméter nem küldhető. [opcionális]
BARION_RECURRING_ENABLED=

# ----------------------------------------------------------------------------
# Seed-script (src/scripts/seed.ts) – csak az első feltöltésnél kell – OPCIONÁLIS
# ----------------------------------------------------------------------------
# Az owner-felhasználó e-mail-címe. Üres = owner@kineticare.local. [opcionális]
SEED_OWNER_EMAIL=
# Az owner induló jelszava. Üres = a script véletlenszerűt generál és naplóz (egyszeri). [opcionális]
SEED_OWNER_PASSWORD=
